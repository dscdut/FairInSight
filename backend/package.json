{
    "name": "fair-insight-backend",
    "version": "1.0.0",
    "main": "index.js",
    "repository": "git@github.com:dscdut/FairInSight.git",
    "author": "dscdut",
    "license": "MIT",
    "prisma": {
        "schema": "prisma/schema",
        "seed": "node prisma/seed.js"
    },
    "scripts": {
        "prepare": "test -d node_modules/husky && husky install || echo \"husky is not installed\"",
        "lint": "eslint --fix --ext .js .",
        "lint:staged": "lint-staged",
        "dev": "npx nodemon --exec npx babel-node src/core/bin/www.js",
        "start": "npm run build && node ./dist/core/bin/www.js",
        "clean": "rm -rf dist && mkdir dist",
        "build:babel": "babel ./src --out-dir dist --copy-files",
        "build": "npm run clean && npm run build:babel",
        "db:migrate": "npx prisma migrate dev",
        "db:studio": "npx prisma studio",
        "db:seed": "npx prisma db seed",
        "postinstall": "prisma generate --schema=prisma/schema"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@sentry/node": "^7.64.0",
        "axios": "^1.4.0",
        "bcrypt": "^5.1.1",
        "cloudinary": "^1.27.1",
        "cors": "^2.8.5",
        "debug": "^4.2.0",
        "dotenv": "^8.2.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-prettier": "^4.0.0",
        "express": "^4.17.2",
        "glob": "^7.2.0",
        "http-status": "^1.5.0",
        "joi": "^17.4.2",
        "jsonwebtoken": "^8.5.1",
        "lodash": "^4.17.21",
        "method-override": "^3.0.0",
        "multer": "^1.4.3",
        "nodemailer": "^6.10.1",
        "pg": "^8.7.1",
        "prettier": "^2.3.0",
        "swagger-ui-express": "^4.1.6",
        "winston": "^3.3.3"
    },
    "devDependencies": {
        "@babel/cli": "^7.10.4",
        "@babel/core": "^7.10.4",
        "@babel/node": "^7.12.10",
        "@babel/plugin-proposal-class-properties": "^7.10.4",
        "@babel/plugin-proposal-decorators": "^7.12.1",
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@babel/plugin-transform-async-to-generator": "^7.10.4",
        "@babel/plugin-transform-runtime": "^7.10.4",
        "@babel/preset-env": "^7.10.4",
        "@babel/register": "^7.10.5",
        "@babel/runtime": "^7.14.0",
        "@commitlint/cli": "^17.5.0",
        "@commitlint/config-conventional": "^17.4.4",
        "@types/node": "^25.6.0",
        "babel-eslint": "^10.1.0",
        "babel-plugin-module-resolver": "^4.1.0",
        "babel-plugin-transform-runtime": "^6.23.0",
        "eslint": "^7.3.1",
        "eslint-config-airbnb-base": "^14.2.0",
        "eslint-plugin-import": "^2.21.2",
        "faker": "^5.5.3",
        "husky": "^8.0.3",
        "lint-staged": "^15.0.2",
        "nodemon": "^2.0.22",
        "prisma": "^7.8.0"
    }
}
