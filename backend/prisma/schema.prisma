generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model ai_messages {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  analysis_id String?   @db.Uuid
  role        ai_role?
  content     String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  analysis    analysis? @relation(fields: [analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_messages_analysis_id_foreign")
}

model analysis {
  id              String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String?       @db.Uuid
  input_data      Json?
  result          String?
  context_summary String?
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?     @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?     @db.Timestamptz(6)
  ai_messages     ai_messages[]
  users           users?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "analysis_user_id_foreign")
}

model chat_requests {
  id             String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id        String?              @db.Uuid
  lawyer_id      String?              @db.Uuid
  status         chat_request_status? @default(PENDING)
  created_at     DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?            @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?            @db.Timestamptz(6)
  lawyer_details lawyer_details?      @relation(fields: [lawyer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "chat_requests_lawyer_id_foreign")
  users          users?               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "chat_requests_user_id_foreign")
}

model conversations {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id         String?         @db.Uuid
  lawyer_id       String?         @db.Uuid
  context_summary String?
  created_at      DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?       @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?       @db.Timestamptz(6)
  lawyer_details  lawyer_details? @relation(fields: [lawyer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "conversations_lawyer_id_foreign")
  users           users?          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "conversations_user_id_foreign")
  messages        messages[]
}

model documents {
  id          String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String?    @db.Uuid
  template_id String?    @db.Uuid
  content     Json?
  file_url    String?
  is_draft    Boolean?   @default(true)
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime?  @db.Timestamptz(6)
  templates   templates? @relation(fields: [template_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "documents_template_id_foreign")
  users       users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "documents_user_id_foreign")
}

model laws {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title           String
  content         String
  document_number String    @db.VarChar(255)
  issued_date     DateTime  @db.Date
  effective_date  DateTime  @db.Date
  source_url      String
  user_id         String    @db.Uuid
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime? @db.Timestamptz(6)
  users           users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "laws_user_id_foreign")
}

model lawyer_certificates {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lawyer_id        String?         @db.Uuid
  certificate_name String          @db.VarChar(255)
  file_url         String
  issued_by        String          @db.VarChar(255)
  issue_date       DateTime        @db.Date
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?       @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?       @db.Timestamptz(6)
  lawyer_details   lawyer_details? @relation(fields: [lawyer_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "lawyer_certificates_lawyer_id_foreign")
}

model lawyer_details {
  user_id             String                @id @db.Uuid
  bio                 String?
  experience_years    Int?
  is_verified         Boolean               @default(false)
  rating_avg          Float?                @default(0) @db.Real
  price_per_hour      Decimal?              @db.Decimal(10, 2)
  status              lawyer_status         @default(OFFLINE)
  bar_association     String?               @db.VarChar(255)
  license_number      String?               @db.VarChar(255)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?             @db.Timestamptz(6)
  chat_requests       chat_requests[]
  conversations       conversations[]
  lawyer_certificates lawyer_certificates[]
  users               users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lawyer_details_user_id_foreign")
  lawyer_experiences  lawyer_experiences[]
  lawyer_specialties  lawyer_specialties[]
  ratings             ratings[]
  reports             reports[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model lawyer_experiences {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lawyer_id      String?         @db.Uuid
  title          String          @db.VarChar(255)
  description    String
  start_date     DateTime        @db.Date
  end_date       DateTime?       @db.Date
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?       @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?       @db.Timestamptz(6)
  lawyer_details lawyer_details? @relation(fields: [lawyer_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "lawyer_experiences_lawyer_id_foreign")
}

model lawyer_specialties {
  lawyer_id      String         @db.Uuid
  specialty_id   String         @db.Uuid
  lawyer_details lawyer_details @relation(fields: [lawyer_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "lawyer_specialties_lawyer_id_foreign")
  specialties    specialties    @relation(fields: [specialty_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "lawyer_specialties_specialty_id_foreign")

  @@id([lawyer_id, specialty_id])
}

model messages {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversation_id String?        @db.Uuid
  sender_id       String?        @db.Uuid
  content         String?
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?      @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?      @db.Timestamptz(6)
  conversations   conversations? @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_conversation_id_foreign")
  users           users?         @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "messages_sender_id_foreign")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ratings {
  user_id        String         @db.Uuid
  lawyer_id      String         @db.Uuid
  rating         Int
  comment        String
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?      @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?      @db.Timestamptz(6)
  lawyer_details lawyer_details @relation(fields: [lawyer_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "ratings_lawyer_id_foreign")
  users          users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ratings_user_id_foreign")

  @@id([user_id, lawyer_id])
}

model refresh_tokens {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String    @unique(map: "refresh_tokens_user_id_unique") @db.Uuid
  token      String    @unique(map: "unique_refresh_token_active", where: raw("(deleted_at IS NULL)"))
  expires_at DateTime  @db.Timestamptz(6)
  is_revoked Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "refresh_tokens_user_id_foreign")

  @@index([user_id], map: "idx_refresh_tokens_user")
}

model reports {
  target_user_id String         @db.Uuid
  reporter_id    String         @db.Uuid
  reason         String
  status         report_status? @default(PENDING)
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?      @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?      @db.Timestamptz(6)
  lawyer_details lawyer_details @relation(fields: [reporter_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "reports_reporter_id_foreign")
  users          users          @relation(fields: [target_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reports_target_user_id_foreign")

  @@id([target_user_id, reporter_id])
}

model roles {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String    @unique(map: "roles_name_unique") @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  users      users[]
}

model specialties {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name               String               @unique(map: "specialties_name_unique") @db.VarChar(255)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?            @db.Timestamptz(6)
  lawyer_specialties lawyer_specialties[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subscriptions {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id    String?   @db.Uuid
  plan_name  String?   @db.VarChar(255)
  start_date DateTime? @db.Timestamptz(6)
  end_date   DateTime? @db.Timestamptz(6)
  quota      Int?
  is_active  Boolean?
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "subscriptions_user_id_foreign")
}

model templates {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String      @db.VarChar(255)
  description String?
  file_url    String
  created_at  DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?   @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime?   @db.Timestamptz(6)
  documents   documents[]
}

model users {
  id                       String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email                    String          @unique(map: "unique_users_email_active", where: raw("(deleted_at IS NULL)")) @db.VarChar(255)
  password_hash            String
  full_name                String          @db.VarChar(255)
  role_id                  String?         @db.Uuid
  avatar_url               String?
  referral_code            String?         @unique(map: "unique_users_referral_active", where: raw("(deleted_at IS NULL)")) @db.VarChar(50)
  referred_by              String?         @db.Uuid
  phone                    String?         @db.VarChar(20)
  date_of_birth            DateTime?       @db.Date
  location                 String?         @db.VarChar(255)
  email_confirmation_token String?
  password_reset_token     String?
  password_reset_expiry    DateTime?       @db.Timestamptz(6)
  is_email_confirmed       Boolean         @default(false)
  last_login_at            DateTime?       @db.Timestamptz(6)
  created_at               DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?       @default(now()) @db.Timestamptz(6)
  deleted_at               DateTime?       @db.Timestamptz(6)
  banned_by                String?         @db.Uuid
  ban_reason               String?
  analysis                 analysis[]
  chat_requests            chat_requests[]
  conversations            conversations[]
  documents                documents[]
  laws                     laws[]
  lawyer_details           lawyer_details?
  messages                 messages[]
  ratings                  ratings[]
  refresh_tokens           refresh_tokens?
  reports                  reports[]
  subscriptions            subscriptions[]
  users                    users?          @relation("usersTousers", fields: [referred_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_referred_by_foreign")
  other_users              users[]         @relation("usersTousers")
  roles                    roles?          @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "users_role_id_foreign")
}

enum ai_role {
  USER
  AI
}

enum chat_request_status {
  PENDING
  ACCEPTED
  REJECTED
}

enum lawyer_status {
  AVAILABLE
  BUSY
  OFFLINE
}

enum report_status {
  PENDING
  RESOLVED
}
