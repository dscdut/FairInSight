model ai_messages {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  analysis_id String?   @db.Uuid
  role        ai_role?
  content     String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  analysis    analysis? @relation(fields: [analysis_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_messages_analysis_id_foreign")
}

model analysis {
  id                    String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id               String?                  @db.Uuid
  input_data            Json?
  result                String?
  context_summary       String?
  created_at            DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?                @default(now()) @db.Timestamptz(6)
  deleted_at            DateTime?                @db.Timestamptz(6)
  ai_messages           ai_messages[]
  users                 users?                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "analysis_user_id_foreign")
  chat_requests         chat_requests[]
  consultationProcesses consultation_processes[]
}

enum ai_role {
  USER
  AI
}
