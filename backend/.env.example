NODE_ENV=development

# Port config
PORT=3000

# Database
# Use postgresql for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fairinsight?schema=public

# JWT config
JWT_SECRET=your_jwt_secret
EXPIRE_DAYS=15m

# Token expiry (milliseconds)
REFRESH_TOKEN_EXPIRY=604800000
FORGOT_PASSWORD_TOKEN_EXPIRY=900000
PASSWORD_RESET_TOKEN_EXPIRY=900000

# Resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=no-reply@fairinsights.com

# Hash password
SALT_ROUNDS=10

# CORS & Host
CORS_ALLOW=*
HOST=http://localhost:3000, http://localhost:5173

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_TYPE=

# Docker (optional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fairinsight

PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin@gmail.com