NODE_ENV=development

# Port config
PORT=3000

# Database
# Use postgresql for local development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fairinsight?schema=public

# JWT config
JWT_SECRET=your_jwt_secret
EXPIRE_DAYS=15m

# Token expiry (milliseconds)
REFRESH_TOKEN_EXPIRY=604800000
FORGOT_PASSWORD_TOKEN_EXPIRY=900000
PASSWORD_RESET_TOKEN_EXPIRY=900000

# Resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=no-reply@fairinsights.com

# Hash password
SALT_ROUNDS=10

# CORS & Host
CORS_ALLOW=*
HOST=http://localhost:3000 
# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_TYPE=

# Docker (optional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fairinsight

PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin@gmail.com

# Billing rollout. Keep SHADOW until accounting/security gates pass.
BILLING_MODE=SHADOW
CHAT_GATEWAY_ENABLED=true
TOPUP_ENABLED=false
ENTERPRISE_ENABLED=false

# Local seed safety. Supply the password at execution time; do not commit it.
SEED_DEMO_PASSWORD=
SEED_ALLOWED_DB_HOSTS=localhost,127.0.0.1,db,postgres
SEED_UPLOAD_TEMPLATES=false

# Node <-> AI service identity. Use an independent 32+ byte secret.
FIS_SERVICE_KEY_ID=local-v1
FIS_SERVICE_SECRET=
AI_SERVICE_BASE_URL=http://localhost:8000
AI_CHAT_TIMEOUT_MS=930000
