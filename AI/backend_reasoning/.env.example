# Mẫu cấu hình AI backend_reasoning. Copy sang .env rồi điền GIÁ TRỊ THẬT.
# KHÔNG commit .env (đã .gitignore). File .example CHỈ chứa placeholder, KHÔNG secret thật.

# --- App ---
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DB_ECHO=false

# --- CORS (FE FairInSight: Vite :4000/:5173, Node BE :3000) ---
CORS_ORIGINS=["http://localhost:4000","http://localhost:5173","http://localhost:3000","http://127.0.0.1:4000","http://127.0.0.1:5173"]

# --- Database (PostgreSQL — Supabase pooler hoặc Postgres local) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- LLM: Ollama ---
# B (mặc định/fallback): qwen3:8b + bge-m3 @ OLLAMA_BASE_URL (Ollama local).
OLLAMA_BASE_URL=http://localhost:11434
# A (ưu tiên): gemma4 26B qua tunnel/domain (vd Mac mini :11500). Lỗi sau CHAT_RETRIES
# lần → tự rớt về B. Bỏ trống = CHỈ chạy local B. ĐỔI URL khi deploy server riêng.
OLLAMA_CHAT_BASE_URL=http://localhost:11500
OLLAMA_CHAT_MODEL=gemma4:26b-a4b-it-q4_K_M
OLLAMA_FALLBACK_MODEL=qwen3:8b
CHAT_RETRIES=3
OLLAMA_EMBED_MODEL=bge-m3
EMBEDDING_DIM=1024
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TEMPERATURE=0.2
# EMBED_LOCAL=true: nạp bge-m3 thẳng trong process (SentenceTransformer CPU), KHÔNG
# cần Ollama ngoài — dùng khi đóng Docker. false: gọi Ollama /api/embed như cũ.
EMBED_LOCAL=false

# --- LLM: 9router (OpenAI-format proxy: Groq/Gemini/NVIDIA) ---
# USE_NINE_ROUTER=true: chat/ingest gọi 9router thay Ollama. false: dùng Ollama (gemma4/qwen3).
USE_NINE_ROUTER=false
NINE_ROUTER_URL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=groq/llama-3.3-70b-versatile
# Giới hạn output token/request. llama-3.3-70b chịu 8192; qwen3-32b chỉ 4096 (lớn hơn → 413).
NINE_ROUTER_MAX_TOKENS=8192

# --- OCR (EasyOCR đọc PDF scan) ---
# GPU nhỏ (<=8GB): OCR_USE_GPU=true + OCR_SWAP_VRAM=true (swap LLM↔OCR).
# Server CPU-only / VRAM lớn: OCR_USE_GPU=false (EasyOCR tự chạy CPU).
OCR_USE_GPU=true
OCR_SWAP_VRAM=true

# --- Reranker (cross-encoder, chạy CPU, đóng sẵn trong image) ---
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# --- LLM: Gemini (API, dự phòng — chưa dùng) ---
GEMINI_API_KEY=

# --- Auth: CHUNG secret với BE Node (FairInSight backend/.env JWT_SECRET) ---
# PHẢI trùng JWT_SECRET của Node BE, nếu không AI verify token sẽ 401.
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Cloudinary: lưu PDF luật gốc (resource_type=raw) ---
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# --- VBPL: nạp văn bản từ link vbpl.vn (cào toàn văn HTML, bỏ OCR) ---
VBPL_API_BASE=https://vbpl-bientap-gateway.moj.gov.vn/api/qtdc/public/doc

# --- Cloudflare Access (nếu tunnel qua cloudflared cần header) — để trống nếu không dùng ---
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
