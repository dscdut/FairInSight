# Mẫu cấu hình AI backend_reasoning. Copy sang .env rồi điền GIÁ TRỊ THẬT.
# KHÔNG commit .env (đã .gitignore). File .example CHỈ chứa placeholder, KHÔNG secret thật.
#
# Giá trị mặc định dưới đây đặt theo HƯỚNG SERVER (Docker, DB cloud, 9router, embed CPU
# trong image). Chạy LOCAL bằng uv thì sửa lại: ENVIRONMENT=development, DEBUG=true,
# EMBED_LOCAL=false (dùng Ollama), USE_NINE_ROUTER=false (dùng gemma4/qwen3 local).

# --- App ---
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
DB_ECHO=false

# --- CORS (FE FairInSight: Vite :4000/:5173, Node BE :3000). Lên server: thêm domain thật. ---
CORS_ORIGINS=["http://localhost:4000","http://localhost:5173","http://localhost:3000","http://127.0.0.1:4000","http://127.0.0.1:5173"]

# --- Database (PostgreSQL — Supabase cloud pooler) ---
# Server FairInSight dùng DB CLOUD: điền connection của Supabase pooler (Transaction mode).
# POSTGRES_USER dạng 'postgres.<project-ref>', HOST là '<region>.pooler.supabase.com'.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOST=
POSTGRES_PORT=5432

# --- LLM: 9router (OpenAI-format proxy: Groq/Gemini/NVIDIA) — ĐƯỜNG CHÍNH trên server ---
# USE_NINE_ROUTER=true: chat/ingest gọi 9router (HTTPS, không cần Ollama). false: dùng Ollama.
USE_NINE_ROUTER=true
NINE_ROUTER_URL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=groq/llama-3.3-70b-versatile
# Giới hạn OUTPUT token/request. llama-3.3-70b chịu 8192; qwen3-32b chỉ 4096 (lớn hơn → 413).
NINE_ROUTER_MAX_TOKENS=8192

# --- Embedding ---
# EMBED_LOCAL=true: nạp bge-m3 thẳng trong process (SentenceTransformer CPU, đóng sẵn trong
# image Docker) — KHÔNG cần Ollama ngoài. false: gọi Ollama /api/embed (cần OLLAMA_BASE_URL).
EMBED_LOCAL=true
EMBED_LOCAL_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- LLM: Ollama (chỉ dùng khi USE_NINE_ROUTER=false hoặc EMBED_LOCAL=false) ---
# B (mặc định/fallback): qwen3:8b + bge-m3 @ OLLAMA_BASE_URL.
OLLAMA_BASE_URL=http://localhost:11434
# A (ưu tiên): gemma4 26B qua tunnel/domain (vd Mac mini :11500). Lỗi sau CHAT_RETRIES lần
# → tự rớt về B. Bỏ trống = chỉ chạy local B. Trong Docker: dùng host.docker.internal.
OLLAMA_CHAT_BASE_URL=
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=qwen3:8b
CHAT_RETRIES=3
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TEMPERATURE=0.2

# --- OCR (EasyOCR đọc PDF scan) ---
# Server CPU-only / không GPU NVIDIA: để false (EasyOCR tự chạy CPU).
# GPU nhỏ (<=8GB) local: OCR_USE_GPU=true + OCR_SWAP_VRAM=true (swap LLM↔OCR).
OCR_USE_GPU=false
OCR_SWAP_VRAM=false

# --- Reranker (cross-encoder, chạy CPU, đóng sẵn trong image) ---
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu

# --- LLM: Gemini (API, dự phòng — chưa dùng) ---
GEMINI_API_KEY=

# --- Auth: CHUNG secret với BE Node (FairInSight backend/.env JWT_SECRET) ---
# PHẢI trùng JWT_SECRET của Node BE, nếu không AI verify token sẽ 401.
JWT_SECRET=
JWT_ALGORITHM=HS256

# --- Cloudinary: lưu PDF luật gốc (resource_type=raw) ---
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# --- VBPL: nạp văn bản từ link vbpl.vn (cào toàn văn HTML, bỏ OCR) ---
VBPL_API_BASE=https://vbpl-bientap-gateway.moj.gov.vn/api/qtdc/public/doc
