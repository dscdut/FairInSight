# ============================================
# FairInsight — Environment Variables
# Copy this file to .env and fill values per environment.
# ============================================

# === APP_* ===
APP_NAME=FairInsight Backend
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8080
APP_CORS_ORIGINS=http://localhost:3000
APP_REQUEST_TIMEOUT_SECONDS=120
APP_SERVE_STATIC=false
APP_INCOGNITO_TTL=0

# === DB_* ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSL_MODE=prefer
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=30
DB_COMMAND_TIMEOUT_SECONDS=30

# === REDIS_* ===
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=fairinsight
REDIS_SESSION_TTL_SECONDS=3600
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_MAX_CONNECTIONS=100

# === LLM_* (OpenRouter + Mistral routing) ===
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-v1-please-set-in-local-env
LLM_SITE_URL=http://localhost:3000
LLM_APP_NAME=FairInsight
LLM_ORGANIZATION_ID=
LLM_ORGANIZATION_NAME=FairInsight
LLM_ROUTER_MODEL=mistralai/ministral-8b
LLM_ANALYST_MODEL=mistralai/mistral-large-2411
LLM_ROUTER_TEMPERATURE=0.1
LLM_ANALYST_TEMPERATURE=0.2
LLM_ROUTER_MAX_TOKENS=1200
LLM_ANALYST_MAX_TOKENS=4000

# === RAG_* ===
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1024
RAG_TOP_K=10
RAG_CANDIDATE_POOL_SIZE=60
RAG_VECTOR_WEIGHT=0.65
RAG_KEYWORD_WEIGHT=0.35
RAG_MIN_SIMILARITY=0.1
RAG_ACTIVE_STATUS_LABEL=Còn hiệu lực

# === AUTH_* ===
AUTH_JWT_SECRET=change-in-production-please-rotate
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_API_KEY_HEADER=X-API-Key

# Optional integrations
CRAWLKIT_API_KEY=
